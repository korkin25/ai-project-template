# Per-repo identity consumed by standard/compose.sh.
# Copy to standard/repo.env and fill in. Committed — it contains no secrets.

# Which profile this repo follows: service | library | platform | infra
PROFILE=service

# Repo name as it appears in the registry, the chart name and the image name.
# Hyphenated. Must equal the GitLab project path segment.
PROJECT=example-service

# Python package / module name. Underscored version of PROJECT.
PKG=example_service

# Ticket id prefix, UPPERCASE, unique across the whole group.
# Tasks are <PREFIX>-<n>, decisions <PREFIX>-D<n>. See "Ticket ids" in the standard.
TICKET_PREFIX=EXSV

# Distribution name of the published package. OPTIONAL — defaults to PROJECT.
# Set it whenever PROJECT alone is not globally unique. A library called "shared"
# must publish as "<group>-shared": consumers pin the DISTRIBUTION name, and a bare
# "shared" either resolves to nothing or to somebody else's package. The IMPORT name
# stays PKG, so `pip install <group>-shared` then `import shared` is correct and
# intentional — they are different namespaces.
# DIST_NAME=<group>-shared

# Full namespace of the repo — the group or subgroup path that owns it.
GROUP=<group>/<subgroup>

# One-line description used in the generated "What this project is" section.
DESCRIPTION=<one-line description>
