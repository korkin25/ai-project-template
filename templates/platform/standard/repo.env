# Per-repo identity, consumed by standard/compose.sh to generate CLAUDE.md from
# standard/base.md + standard/profiles/platform.md. Committed — it contains no secrets.
#
# The values below are scaffold placeholder tokens, substituted when this template is
# instantiated. compose.sh REFUSES to run while any remain (TICKET_PREFIX is validated as
# uppercase A-Z0-9, and the generated file is scanned for leftover tokens) — a repo whose
# rulebook still names a placeholder was never really adopted.
#
# After substitution, run `./standard/compose.sh` and commit the generated CLAUDE.md.

# Which profile this repo follows: service | library | platform | infra
PROFILE=platform

# Repo name as it appears in the GitLab path. Hyphenated. This is also the name the whole
# system is known by, so it shows up in bundle names and in the namespace they deploy into —
# keep those in step with it rather than inventing a second name for the same platform.
PROJECT=@@PROJECT@@

# PKG has no Python package to name in a platform repo: `scripts/` are standalone
# executables, not an importable package. compose.sh still requires every field to be
# non-empty (a silently empty value would render as a blank in CLAUDE.md), so use the
# underscored repo name; nothing imports it.
PKG=@@PKG@@

# Ticket id prefix, UPPERCASE, unique across the whole group. THIS ONE IS THE PLATFORM ID:
# `<PREFIX>-<n>` names work that spans repos and `<PREFIX>-D<n>` records the decisions no
# single service repo can own, so every other repo in the group cites this prefix from its
# own TODO and MR titles. Changing it later invalidates those citations everywhere at once.
TICKET_PREFIX=@@PREFIX@@

# GitLab namespace that owns the repo, e.g. <group>/platform.
GROUP=@@GROUP@@

# One-line description, used in the generated "What this project is" section.
DESCRIPTION=@@DESCRIPTION@@
