# Editor defaults, so a diff never mixes a real change with a whitespace change.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 2 spaces for the config languages, matching the shared CI templates and every Helm chart
# in the group — a 4-space Helm template is diff noise against every other repo.
[*.{yml,yaml,json,toml}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break; trimming them silently reflows
# documents.
[*.md]
trim_trailing_whitespace = false
