# Per-repo identity, consumed by standard/compose.sh to generate CLAUDE.md from
# standard/base.md + standard/profiles/infra.md. Committed — it contains no secrets.
#
# The values below are scaffold placeholder tokens, substituted when this template is
# instantiated. compose.sh REFUSES to run while any remain (TICKET_PREFIX is validated as
# uppercase A-Z0-9, and the generated file is scanned for leftover tokens) — a repo whose
# rulebook still names a placeholder was never really adopted.
#
# After substitution, run `./standard/compose.sh` and commit the generated CLAUDE.md.

# Which profile this repo follows: service | library | platform | infra
PROFILE=infra

# Repo name as it appears in the GitLab path. Hyphenated.
PROJECT=@@PROJECT@@

# PKG has no Python package to name in an infra repo, but compose.sh requires every field to
# be non-empty (a silently empty value would render as a blank in CLAUDE.md). Use the
# underscored repo name; nothing imports it.
PKG=@@PKG@@

# Ticket id prefix, UPPERCASE, unique across the whole group — infra tickets are cited from
# other repos more often than most ("blocked on <PREFIX>-12, the runner").
TICKET_PREFIX=@@PREFIX@@

# GitLab namespace that owns the repo, e.g. <group>/infra.
GROUP=@@GROUP@@

# One-line description, used in the generated "What this project is" section.
DESCRIPTION=@@DESCRIPTION@@
